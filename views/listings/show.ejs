<% layout("/layouts/boilerplate.ejs") %>

    <body>
        <div class="row">
            <div class="col-8 offset-2">
                <br>
                <h2>Details of this Hotel:</h2>
                <div class="card listing-card-r" style="width: 18rem;">
                    <img src="<%= value.image.url %>" class="card-img-top list-img-show" alt="image">
                    <div class="card-body">
                        <p class="card-text"><big><b>
                                    <%= value.title %>
                                </b></big></p>
                        <p class="card-text">Owned by: <i>
                                <%= value.owner.username %>
                            </i></p>
                    </div>
                </div>

                <ul>
                    <div class="list-lis-show">
                        <li>
                            <%=value.description%>
                        </li>

                        <li>&#8377;<%=value.price.toLocaleString("en-IN")%></li>
                        <li>
                            <%=value.location%>
                        </li>
                        <li>
                            <%=value.country%>
                        </li>
                    </div>
                </ul><br>
                <% if(currUser && currUser._id.equals(value.owner._id)) {%>
                    <div class="row">
                        <div class=" col-6">
                            <a class="btn btn-dark add-list-btn w-100" href="/listings/<%= value._id %>/edit">Edit</a>
                        </div>
                        <div class="col-6">
                            <form method="post" action="/listings/<%= value._id %>?_method=DELETE">
                                <button class="btn btn-dark w-100">Delete</button><br><br>
                            </form>
                        </div>
                    </div>
                    <% } %>
            </div>
            <hr>
            <div class="col-8 offset-2">
                <% if(currUser) {%>
                    <h3>Leave a Review:</h3>
                    <form method="post" action="/listings/<%= value._id %>/reviews" novalidate class="needs-validation">

                        
                            <!-- <input type="range" id="review" class="form-range" min="1" max="5" name="review[rating]"> -->
                       
                        <div class="mb-3" >
                        <label for="review" class="form-label">Rating</label>
                        <fieldset class="starability-slot ">
                          
                            <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked
                                aria-label="No rating." />
                            <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                            <label for="first-rate1" title="Terrible">1 star</label>
                            <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                            <label for="first-rate2" title="Not good">2 stars</label>
                            <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                            <label for="first-rate3" title="Average">3 stars</label>
                            <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                            <label for="first-rate4" title="Very good">4 stars</label>
                            <input type="radio" id="first-rate5" name="review[rating]" value="5" />
                            <label for="first-rate5" title="Amazing">5 stars</label>
                        </fieldset>
                        </div>
                        <div class="mb-3">
                            <label for="comment" class="form-label">Comments</label>
                            <textarea class="form-control" id="comment" rows="4" name="review[comment]"
                                placeholder="Write Comments Here" required></textarea>
                            <div class="invalid-feedback">
                                Please add some comment
                            </div>
                        </div>
                        <div>
                            <button class="btn btn-outline-dark">Submit the Review</button>
                        </div>
                    </form>
                    <hr>
                    <%} %>

                        <h4>All Reviews</h4><br>
                        <div class="row">
                            <% for(review of value.reviews){%>
                                <div class="card col-5 mb-3 me-3">
                                    <div class="card-body ">
                                        <h5 class="card-title"><b>@<%= review.author.username %></b></h5>
                                        <p class="starability-result  card-text" data-rating="<%= review.rating %>"> </p>
                                        <h6 class="card-subtitle mb-2 text-body-secondary">
                                            <%= review.comment %>
                                        </h6>
                                        <form method="post"
                                            action="/listings/<%= value._id %>/reviews/<%= review._id %>?_method=DELETE">
                                            <button class="btn btn-sm btn-dark mb-2">Delete</button>
                                        </form>

                                    </div>
                                </div>
                                <%} %>
                        </div>

            </div>
        </div>
    </body>